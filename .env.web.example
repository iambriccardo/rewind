# Phone simulator web server. Browser-safe values only.
WEB_HOST=127.0.0.1
WEB_PORT=8788
WEB_HTTPS=false

# Backend API URL used by the simulator browser.
# Use http://localhost:8787 for desktop testing, or your Mac LAN URL for phone testing.
BACKEND_URL=http://localhost:8787

# Development identity sent as headers/query params to the local backend.
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_DEVICE_ID=dev-phone

# Append-only local frame cache used to imitate device-side frame storage.
WEB_FRAME_STORE_PATH=.data/device-frames

# Optional HTTPS for camera/microphone testing from a phone over LAN.
WEB_TLS_CERT_PATH=
WEB_TLS_KEY_PATH=
