# Phone web app
WEB_HOST=127.0.0.1
WEB_PORT=8788
WEB_HTTPS=false

# Use http://localhost:8787 for desktop testing.
# Use your Mac LAN URL for phone testing, for example http://192.168.1.20:8787.
BACKEND_URL=http://localhost:8787

DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_DEVICE_ID=dev-phone

# Optional HTTPS for phone camera testing over LAN.
# WEB_TLS_CERT_PATH=certs/rewind.local.pem
# WEB_TLS_KEY_PATH=certs/rewind.local-key.pem
