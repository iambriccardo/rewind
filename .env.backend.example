# Backend
PORT=8787
HOST=0.0.0.0
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_DEVICE_ID=dev-phone

# Repository mode:
# - local: JSON persistence in .data/rewind.json, no database needed
# - supabase: use SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
REPOSITORY_MODE=local
LOCAL_DATA_PATH=.data/rewind.json

# Supabase local defaults can be printed with: supabase status -o env
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Model / embeddings
MODEL_API_KEY=
EMBEDDING_MODE=text_only
LIVE_MODEL_NAME=gemini-2.5-flash-native-audio-preview-12-2025

# Backend should not serve the phone app in Docker. Keep false for the split setup.
SERVE_DEMO_APP=false

# Optional HTTPS for backend testing over LAN.
# Generate certs with mkcert or your preferred local CA, then set:
# DEV_HTTPS=false
# TLS_CERT_PATH=certs/rewind.local.pem
# TLS_KEY_PATH=certs/rewind.local-key.pem
