# Rewind backend API
PORT=8787
HOST=0.0.0.0
DEV_USER_ID=00000000-0000-4000-8000-000000000001
DEV_DEVICE_ID=dev-phone

# Supabase database. Docker local mode injects local Supabase values automatically.
# For manual local backend runs, copy values from: supabase status -o env
# For remote runs, set the hosted URL and service-role key here explicitly.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Model provider. Code currently targets Gemini through @google/genai.
MODEL_API_KEY=
# text_only stores event embeddings only; text_and_image also embeds selected committed frames.
EMBEDDING_MODE=text_only
TEXT_EMBEDDING_MODEL=gemini-embedding-2
IMAGE_EMBEDDING_MODEL=gemini-embedding-2
LIVE_MODEL_NAME=gemini-2.5-flash-native-audio-preview-12-2025

# Optional HTTPS for the backend API when testing devices over LAN.
DEV_HTTPS=false
TLS_CERT_PATH=
TLS_KEY_PATH=
